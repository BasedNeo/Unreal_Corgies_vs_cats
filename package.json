{
  "name": "corgis-vs-cats-three",
  "version": "0.1.0",
  "private": true,
  "description": "Corgis vs Cats \u2014 multiplayer third-person action-platformer built with Three.js (WebGPU/TSL), Rapier and an authoritative TypeScript simulation.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "server": "tsx server/index.ts",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "check:boundaries": "node tools/check-boundaries.mjs",
    "test:e2e": "playwright test",
    "gate": "node tools/gate.mjs",
    "gate:fast": "node tools/gate.mjs --fast",
    "server:prod": "tsx server/prod.ts",
    "start": "vite build && tsx server/prod.ts",
    "build:server": "vite build --ssr server/prod.ts --outDir dist-server --emptyOutDir",
    "precompress": "tsx server/precompress.ts dist",
    "start:prod": "node dist-server/prod.js",
    "net:bots": "tsx tools/net-bots.ts",
    "test:net": "vitest run tests/unit/net --reporter=verbose",
    "soak": "tsx tools/soak.mjs",
    "verify": "node tools/verify-commit.mjs"
  },
  "dependencies": {
    "@dimforge/rapier3d-compat": "0.21.0",
    "three": "0.186.1",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "@gltf-transform/core": "^4.5.1",
    "@gltf-transform/extensions": "^4.5.1",
    "@gltf-transform/functions": "^4.5.1",
    "@playwright/test": "1.56.1",
    "@types/node": "^22.10.0",
    "@types/three": "0.186.0",
    "@types/ws": "^8.18.1",
    "meshoptimizer": "^1.3.0",
    "sharp": "^0.35.5",
    "tsx": "^4.23.15",
    "typescript": "5.9.3",
    "vite": "^8.3.1",
    "vitest": "^5.0.2"
  }
}
